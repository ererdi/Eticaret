@model IEnumerable<Product>

@{
	ViewData["Title"] = "Ürünlerimiz";
}

<div class="my-5">
    <h1 class="text-center"> Ürünlerimiz</h1>
    <div class="row gx-4 gx-lg-5 row row-cols-xl-4 justify-content-center ">
